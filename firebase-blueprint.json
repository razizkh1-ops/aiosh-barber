{
  "entities": {
    "appointment": {
      "title": "Appointment",
      "description": "An appointment booked at AIOSH BARBER salon in Sakhnin",
      "type": "object",
      "properties": {
        "bookingRef": {
          "type": "string",
          "description": "Unique booking reference code",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "serviceIds": {
          "type": "array",
          "description": "List of selected service IDs"
        },
        "serviceNames": {
          "type": "array",
          "description": "List of selected service names"
        },
        "totalPrice": {
          "type": "number",
          "description": "Total price in ILS"
        },
        "totalDurationMin": {
          "type": "number",
          "description": "Total duration in minutes"
        },
        "barberId": {
          "type": "string",
          "description": "ID of the barber",
          "maxLength": 64
        },
        "barberName": {
          "type": "string",
          "description": "Name of the barber",
          "maxLength": 64
        },
        "date": {
          "type": "string",
          "description": "Date of appointment in YYYY-MM-DD format",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": "string",
          "description": "Time of appointment in HH:mm format",
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name",
          "maxLength": 100
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone number",
          "maxLength": 30
        },
        "customerEmail": {
          "type": "string",
          "description": "Customer email address (optional)",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or requests",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Current status of the appointment",
          "enum": ["confirmed", "cancelled", "completed"]
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format",
          "maxLength": 50
        },
        "userId": {
          "type": "string",
          "description": "Auth UID of the customer if authenticated",
          "maxLength": 128
        }
      },
      "required": [
        "bookingRef",
        "serviceIds",
        "serviceNames",
        "totalPrice",
        "totalDurationMin",
        "barberId",
        "barberName",
        "date",
        "time",
        "customerName",
        "customerPhone",
        "status",
        "createdAt"
      ]
    },
    "admin": {
      "title": "Admin",
      "description": "Barber salon administrator record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Role description",
          "enum": ["owner", "admin"]
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": "appointment",
      "description": "Collection of customer appointments"
    },
    "/admins/{adminId}": {
      "schema": "admin",
      "description": "Collection of authorized barber admins"
    }
  }
}
