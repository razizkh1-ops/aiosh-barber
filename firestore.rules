rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'razi.z.kh1@gmail.com' && request.auth.token.email_verified == true)
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Appointment Validation Helper
    function isValidAppointment(data) {
      return data.keys().hasAll([
        'bookingRef', 'serviceIds', 'serviceNames', 'totalPrice', 'totalDurationMin',
        'barberId', 'barberName', 'date', 'time', 'customerName', 'customerPhone',
        'status', 'createdAt'
      ])
      && data.bookingRef is string && data.bookingRef.size() <= 32 && data.bookingRef.matches('^[a-zA-Z0-9_\\-]+$')
      && data.serviceIds is list && data.serviceIds.size() > 0 && data.serviceIds.size() <= 10
      && data.serviceNames is list && data.serviceNames.size() > 0 && data.serviceNames.size() <= 10
      && data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 5000
      && data.totalDurationMin is number && data.totalDurationMin >= 10 && data.totalDurationMin <= 480
      && data.barberId is string && data.barberId.size() <= 64
      && data.barberName is string && data.barberName.size() <= 64
      && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.time is string && data.time.matches('^[0-9]{2}:[0-9]{2}$')
      && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
      && data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 30
      && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 100))
      && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
      && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
      && data.status in ['confirmed', 'cancelled', 'completed']
      && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().status == 'confirmed'
        && (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid));
      allow update: if isValidId(appointmentId)
        && isValidAppointment(incoming())
        && (
          isAdmin() ||
          (
            isSignedIn()
            && resource.data.userId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
            && incoming().status == 'cancelled'
          )
        );
      allow delete: if isValidId(appointmentId) && isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }
  }
}
